{
	"name": "Postmill Dev Container",
	// Built from the production Dockerfile's `builder` stage: it already has the
	// toolchain for the native modules (canvas, sharp, bcrypt) and the full source
	// with devDependencies installed, which is exactly what a dev container needs.
	// The runtime stage is deliberately pruned of devDeps, so don't target it.
	"build": {
		"dockerfile": "../Dockerfile",
		"context": "..",
		"target": "builder"
	},
	"features": {},
	"customizations": {
		"vscode": {
			"settings": {},
			"extensions": []
		}
	},
	"forwardPorts": [4200, 3000]
}
